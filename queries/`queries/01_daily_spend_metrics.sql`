-- 01: Average, maximum, and minimum daily spend for Google and Facebook Ads
WITH unified_ads AS (
    SELECT ad_date, 'Facebook' AS media_source, spend FROM public.facebook_ads_basic_daily
    UNION ALL
    SELECT ad_date, 'Google' AS media_source, spend FROM public.google_ads_basic_daily
)
SELECT 
    media_source,
    ROUND(AVG(spend)::numeric, 2) AS avg_spend,
    ROUND(MAX(spend)::numeric, 2) AS max_spend,
    ROUND(MIN(spend)::numeric, 2) AS min_spend
FROM unified_ads
GROUP BY media_source;
